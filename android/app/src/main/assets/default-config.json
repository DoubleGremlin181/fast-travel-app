{
  "$schema": "./config.schema.json",
  "version": 2,
  "defaultCommand": "g",
  "defaultSuggestionsApi": "https://suggestqueries.google.com/complete/search?client=firefox&q={query}",
  "groups": [
    {
      "id": "search-engines",
      "name": "Search Engines",
      "color": "#4285F4",
      "commands": [
        {
          "id": "google",
          "triggers": [
            "g",
            "google"
          ],
          "name": "Google",
          "type": "standard",
          "iconUrl": "https://www.google.com/s2/favicons?domain=google.com&sz=128",
          "suggestionsApi": "https://suggestqueries.google.com/complete/search?client=firefox&q={query}",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://www.google.com",
              "searchUrl": "https://www.google.com/search?q={query}"
            }
          ]
        },
        {
          "id": "duckduckgo",
          "triggers": [
            "ddg"
          ],
          "name": "DuckDuckGo",
          "type": "standard",
          "iconUrl": "https://www.google.com/s2/favicons?domain=duckduckgo.com&sz=128",
          "suggestionsApi": "https://duckduckgo.com/ac/?q={query}&type=list",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://duckduckgo.com",
              "searchUrl": "https://duckduckgo.com/?q={query}"
            }
          ]
        },
        {
          "id": "bing",
          "triggers": [
            "bing"
          ],
          "name": "Bing",
          "type": "standard",
          "iconUrl": "https://icons.duckduckgo.com/ip3/bing.com.ico",
          "suggestionsApi": "https://www.bing.com/osjson.aspx?query={query}",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://www.bing.com",
              "searchUrl": "https://www.bing.com/search?q={query}"
            }
          ]
        },
        {
          "id": "gi",
          "triggers": [
            "gi"
          ],
          "name": "Google Images",
          "type": "standard",
          "iconUrl": "https://www.google.com/s2/favicons?domain=google.com&sz=128",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://www.google.com/imghp",
              "searchUrl": "https://www.google.com/search?tbm=isch&q={query}"
            }
          ]
        },
        {
          "id": "og",
          "triggers": [
            "og"
          ],
          "name": "Google - Pre AI",
          "type": "standard",
          "iconUrl": "https://www.google.com/s2/favicons?domain=google.com&sz=128",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://www.google.com",
              "searchUrl": "https://www.google.com/search?q={query}&udm=14&tbs=cdr:1,cd_min:1/1/1900,cd_max:12/31/2022"
            }
          ]
        },
        {
          "id": "qq",
          "triggers": [
            "qq"
          ],
          "name": "ChatGPT",
          "type": "standard",
          "iconUrl": "https://www.google.com/s2/favicons?domain=chat.openai.com&sz=128",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://chat.openai.com",
              "searchUrl": "https://chat.openai.com/?q={query}"
            }
          ]
        }
      ]
    },
    {
      "id": "reference",
      "name": "Reference",
      "color": "#EA4335",
      "commands": [
        {
          "id": "dict",
          "triggers": [
            "dict"
          ],
          "name": "Dictionary.com",
          "type": "standard",
          "iconUrl": "https://icons.duckduckgo.com/ip3/dictionary.com.ico",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://www.dictionary.com",
              "searchUrl": "https://www.dictionary.com/browse/{query}"
            }
          ]
        },
        {
          "id": "wut",
          "triggers": [
            "wut"
          ],
          "name": "Urban Dictionary",
          "type": "standard",
          "iconUrl": "https://icons.duckduckgo.com/ip3/urbandictionary.com.ico",
          "suggestionsApi": "https://api.urbandictionary.com/v0/autocomplete?term={query}",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://www.urbandictionary.com",
              "searchUrl": "https://www.urbandictionary.com/define.php?term={query}"
            }
          ]
        },
        {
          "id": "wikipedia",
          "triggers": [
            "w"
          ],
          "name": "Wikipedia",
          "type": "standard",
          "iconUrl": "https://www.google.com/s2/favicons?domain=en.wikipedia.org&sz=128",
          "suggestionsApi": "https://en.wikipedia.org/w/api.php?action=opensearch&search={query}&format=json",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://en.wikipedia.org",
              "searchUrl": "https://en.wikipedia.org/w/index.php?search={query}"
            }
          ]
        },
        {
          "id": "scholar",
          "triggers": [
            "scholar"
          ],
          "name": "Google Scholar",
          "type": "standard",
          "iconUrl": "https://www.google.com/s2/favicons?domain=scholar.google.com&sz=128",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://scholar.google.com",
              "searchUrl": "https://scholar.google.com/scholar?q={query}"
            }
          ]
        }
      ]
    },
    {
      "id": "utilities",
      "name": "Utilities",
      "color": "#34A853",
      "commands": [
        {
          "id": "calc",
          "triggers": [
            "calc"
          ],
          "name": "Desmos Scientific Calculator",
          "type": "standard",
          "iconUrl": "https://www.google.com/s2/favicons?domain=desmos.com&sz=128",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://www.desmos.com/scientific",
              "searchUrl": "https://www.desmos.com/scientific"
            }
          ]
        },
        {
          "id": "cal",
          "triggers": [
            "cal"
          ],
          "name": "Google Calendar",
          "type": "standard",
          "iconUrl": "https://fonts.gstatic.com/s/i/productlogos/calendar_2020q4/v10/web-96dp/logo_calendar_2020q4_color_2x_web_96dp.png",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://calendar.google.com",
              "searchUrl": "https://calendar.google.com",
              "patterns": [
                {
                  "match": "event/{title}/{date}/{time}",
                  "url": "https://calendar.google.com/calendar/r/eventedit?text={title}&dates={date}T{time}Z"
                }
              ]
            }
          ]
        },
        {
          "id": "google-maps",
          "triggers": [
            "maps"
          ],
          "name": "Google Maps",
          "type": "standard",
          "iconUrl": "https://icons.duckduckgo.com/ip3/maps.google.com.ico",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://maps.google.com",
              "searchUrl": "https://maps.google.com/?q={query}",
              "patterns": [
                {
                  "match": "directions/{from}/{to}",
                  "url": "https://maps.google.com/dir/{from}/{to}"
                }
              ]
            }
          ]
        },
        {
          "id": "gd",
          "triggers": [
            "gd"
          ],
          "name": "Google Drive",
          "type": "standard",
          "iconUrl": "https://fonts.gstatic.com/s/i/productlogos/drive_2020q4/v10/web-96dp/logo_drive_2020q4_color_2x_web_96dp.png",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://drive.google.com",
              "searchUrl": "https://drive.google.com/drive/search?q={query}"
            }
          ]
        },
        {
          "id": "file",
          "triggers": [
            "file"
          ],
          "name": "File Browser",
          "type": "standard",
          "routes": [
            {
              "devices": ["Windows", "MacOS", "Linux", "Unknown"],
              "defaultUrl": "file:///",
              "patterns": [
                {
                  "match": "{path}",
                  "url": "file:///{path}"
                }
              ]
            }
          ]
        },
        {
          "id": "gmail",
          "triggers": [
            "gm"
          ],
          "name": "Gmail",
          "type": "standard",
          "iconUrl": "https://fonts.gstatic.com/s/i/productlogos/gmail_2020q4/v10/web-96dp/logo_gmail_2020q4_color_2x_web_96dp.png",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://mail.google.com/mail/u/0/#inbox",
              "searchUrl": "https://mail.google.com/mail/u/0/#search/{query}",
              "patterns": [
                {
                  "match": "u/{account_number}",
                  "url": "https://mail.google.com/mail/u/{account_number}/#inbox"
                }
              ]
            }
          ]
        },
        {
          "id": "mailto",
          "triggers": [
            "mailto"
          ],
          "name": "Email",
          "type": "standard",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "mailto:",
              "patterns": [
                {
                  "match": "{email}",
                  "url": "mailto:{email}"
                },
                {
                  "match": "{email}?subject={subject}&body={body}",
                  "url": "mailto:{email}?subject={subject}&body={body}"
                }
              ]
            }
          ]
        },
        {
          "id": "app-stores",
          "triggers": [
            "apps"
          ],
          "name": "App Stores",
          "type": "standard",
          "iconUrl": "https://www.google.com/s2/favicons?domain=play.google.com&sz=128",
          "iconOverrides": [
            {
              "devices": [
                "iOS"
              ],
              "iconUrl": "https://www.google.com/s2/favicons?domain=apps.apple.com&sz=128"
            },
            {
              "devices": [
                "Windows",
                "MacOS",
                "Linux",
                "Unknown"
              ],
              "iconUrl": "https://www.google.com/s2/favicons?domain=store.steampowered.com&sz=128"
            }
          ],
          "routes": [
            {
              "devices": [
                "Android"
              ],
              "defaultUrl": "https://play.google.com/store",
              "searchUrl": "https://play.google.com/store/search?q={query}",
              "patterns": [
                {
                  "match": "developer/{dev_name}",
                  "url": "https://play.google.com/store/apps/developer?id={dev_name}"
                }
              ]
            },
            {
              "devices": [
                "iOS"
              ],
              "defaultUrl": "https://apps.apple.com",
              "searchUrl": "https://apps.apple.com/search?q={query}",
              "patterns": [
                {
                  "match": "developer/{dev_name}",
                  "url": "https://apps.apple.com/developer/{dev_name}"
                }
              ]
            },
            {
              "devices": [
                "MacOS",
                "Windows",
                "Linux",
                "Unknown"
              ],
              "defaultUrl": "https://store.steampowered.com",
              "searchUrl": "https://store.steampowered.com/search/?term={query}",
              "patterns": [
                {
                  "match": "category/{category_name}",
                  "url": "https://store.steampowered.com/category/{category_name}"
                }
              ]
            }
          ]
        },
        {
          "id": "ub",
          "triggers": [
            "ub"
          ],
          "name": "Unblock via archive.today",
          "type": "standard",
          "iconUrl": "https://www.google.com/s2/favicons?domain=archive.today&sz=128",
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://archive.today",
              "searchUrl": "https://archive.today/submit/?url={query}"
            }
          ]
        },
        {
          "id": "flightaware",
          "triggers": [
            "fa"
          ],
          "name": "FlightAware",
          "type": "standard",
          "iconUrl": "https://www.google.com/s2/favicons?domain=flightaware.com&sz=128",
          "normalize": ["stripSpaces"],
          "routes": [
            {
              "devices": "*",
              "defaultUrl": "https://beta.flightaware.com/",
              "searchUrl": "https://beta.flightaware.com/live/flight/{query}",
              "patterns": [
                {
                  "match": "f/{flight_number}",
                  "url": "https://beta.flightaware.com/live/flight/{flight_number}"
                },
                {
                  "match": "a/{airport_code}",
                  "url": "https://beta.flightaware.com/live/airport/{airport_code}"
                },
                {
                  "match": "{code:3}",
                  "url": "https://beta.flightaware.com/live/airport/{code}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
