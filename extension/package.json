{
  "name": "fast-travel-extension",
  "version": "2.0.4",
  "private": true,
  "description": "Fast Travel browser extension",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --firefox",
    "build:all": "node scripts/build.mjs --firefox && rm -rf dist-firefox && cp -r dist dist-firefox && node scripts/build.mjs && rm -rf dist-chrome && cp -r dist dist-chrome",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:install": "playwright test tests/e2e/install.spec.ts",
    "record:store-video": "npm run build && node scripts/record-store-video.mjs",
    "lint": "web-ext lint --source-dir dist/"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/chrome": "^0.1.40",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "web-ext": "^10.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0"
  }
}
